# Port d'écoute du serveur Node
PORT=3000

# URL publique du site (base des liens d'invitation /j/CODE et des liens magiques)
PUBLIC_URL=https://rikiki.example.com

# Secret de signature des JWT — générer avec : openssl rand -hex 32
JWT_SECRET=change-me

# Chemin du fichier SQLite (comptes + stats)
DB_PATH=./data/rikiki.db

# Délai minimal (ms) avant qu'un joueur automatique ne joue (0 = instantané)
BOT_DELAY_MS=800

# Notifications « c'est ton tour » (Web Push / VAPID)
# Optionnel : si ces clés sont absentes, une paire est générée au premier
# démarrage et conservée en base (table server_settings) — elle reste donc
# stable entre les redémarrages. Pour générer une paire à la main :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identité du serveur exigée par VAPID (mailto:… ou URL) ; défaut : PUBLIC_URL
VAPID_SUBJECT=mailto:no-reply@example.com

# ---------------------------------------------------------------------------
# Envoi des liens magiques (« Sauvegarder ma progression »)
#
# Optionnel : sans configuration, le jeu tourne intégralement, seuls les
# comptes e-mail sont désactivés. UNE SEULE des trois options ci-dessous suffit.
# Le fournisseur est déduit des clés présentes ; MAIL_PROVIDER ne sert qu'à
# forcer un choix (resend | brevo | smtp | console).
#MAIL_PROVIDER=

# Expéditeur commun à tous les fournisseurs
MAIL_FROM="Rikiki <no-reply@example.com>"

# --- Option A : Resend (gratuit, 3 000 e-mails/mois) — recommandé si vous avez
# un domaine. https://resend.com → API Keys. L'envoi passe en HTTPS : aucun port
# SMTP sortant à ouvrir. Sans MAIL_FROM sur un domaine vérifié, Resend ne livre
# qu'à l'adresse du titulaire du compte.
#RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Option B : Brevo (gratuit, 300 e-mails/jour) — recommandé sans domaine :
# une simple adresse d'expéditeur validée suffit (y compris une adresse Gmail).
# https://app.brevo.com → SMTP & API → API Keys. Envoi en HTTPS également.
#BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Option C : n'importe quel serveur SMTP (messagerie du domaine, Gmail avec
# un mot de passe d'application, relais Brevo smtp-relay.brevo.com:587…).
# Attention : de nombreux hébergeurs bloquent les ports 25/465/587 en sortie.
#SMTP_HOST=smtp.hostinger.com
#SMTP_PORT=465
#SMTP_USER=no-reply@example.com
#SMTP_PASS=change-me
