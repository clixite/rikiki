# Port d'écoute du serveur Node
PORT=3000

# URL publique du site (base des liens d'invitation /j/CODE et des liens magiques)
PUBLIC_URL=https://rikiki.example.com

# Secret de signature des JWT — générer avec : openssl rand -hex 32
JWT_SECRET=change-me

# Chemin du fichier SQLite (comptes + stats)
DB_PATH=./data/rikiki.db

# Délai minimal (ms) avant qu'un joueur automatique ne joue (0 = instantané)
BOT_DELAY_MS=800

# SMTP pour l'envoi des liens magiques (optionnel : sans SMTP, les comptes e-mail sont désactivés)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
SMTP_FROM="Rikiki <no-reply@example.com>"
