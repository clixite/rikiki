{
  "name": "rikiki-ios",
  "version": "1.3.0",
  "private": true,
  "description": "Conteneur natif iOS de Rikiki (Capacitor)",
  "scripts": {
    "build:web": "cd .. && VITE_API_BASE=https://rikiki.clixite-prod.cloud npm run build -w client",
    "sync": "npm run build:web && cap sync ios",
    "open": "cap open ios",
    "assets": "cap assets generate --ios --assetPath assets --iosProject App"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
